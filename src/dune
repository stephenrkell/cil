(include_subdirs unqualified)

(library
  (name modelCommon)
  (package goblint-cil)
  (modules modelCommon)
  (libraries yojson ppx_deriving_yojson.runtime)
  (preprocess (pps ppx_enumerate ppx_deriving.show ppx_deriving_yojson))
)

(library
  (public_name goblint-cil)
  (name goblintCil)
  (libraries yojson zarith unix str stdlib-shims modelCommon)
  (modules (:standard \ main mainFeature ciloptions modelConfigure modelConfigureMain modelCommon))
)

(library
 (name modelConfigure)
 (package goblint-cil)
 (modules modelConfigure)
 (libraries yojson dune-configurator modelCommon)
)

; for Cilly.pm
(executable
 (name modelConfigureMain)
 (modules modelConfigureMain)
 (libraries yojson dune-configurator modelCommon modelConfigure)
)

; for Cilly.pm
(rule
 (target gcc32model)
 (action (with-stdout-to %{target} (run ./modelConfigureMain.exe --cc %{read-lines:../bin/real-gcc} -m 32))))

; for Cilly.pm
(rule
 (target gcc64model)
 (action (with-stdout-to %{target} (run ./modelConfigureMain.exe --cc %{read-lines:../bin/real-gcc} -m 64))))

; for Cilly.pm
(rule
 (target defaultmodel)
 (action (with-stdout-to %{target} (run ./modelConfigureMain.exe --cc %{read-lines:../bin/real-gcc}))))

(ocamllex formatlex)
(ocamlyacc formatparse)

(executable
 (name main)
 (modules main mainFeature ciloptions)
 (modes native)
 (libraries goblint-cil dynlink findlib yojson ppx_deriving_yojson.runtime modelCommon)
 (flags :standard -linkall))

(env
  (dev
    (flags (:standard -warn-error -A -w -unused-var-strict)) ; https://dune.readthedocs.io/en/stable/faq.html#how-to-make-warnings-non-fatal
  )
)

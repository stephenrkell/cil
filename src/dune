(include_subdirs unqualified)

(library
  (name modelCommon)
  (package goblint-cil)
  (modules modelCommon)
  (libraries yojson ppx_deriving_yojson.runtime)
  (preprocess (pps ppx_enumerate ppx_deriving.show ppx_deriving_yojson))
)

(library
  (public_name goblint-cil)
  (name goblintCil)
  (libraries yojson zarith unix str stdlib-shims modelCommon)
  (modules (:standard \ main mainFeature ciloptions machdepConfigure machdepArchConfigure modelConfigure modelCommon))
)

(executable
 (name machdepConfigure)
 (modules machdepConfigure)
 (libraries dune-configurator))

(rule
 (target machdep-config.h)
 (action (run ./machdepConfigure.exe --cc %{read-lines:../bin/real-gcc})))

(rule
 (target machdep32-config.h)
 (action (run ./machdepConfigure.exe --cc %{read-lines:../bin/real-gcc} -m 32)))

(rule
 (target machdep64-config.h)
 (action (run ./machdepConfigure.exe --cc %{read-lines:../bin/real-gcc} -m 64)))

(rule
 (deps machdep-config.h machdep-ml.c)
 (target machdep-ml.exe)
 (action (run %{read-lines:../bin/real-gcc} -D_GNUCC -include machdep-config.h machdep-ml.c -o %{target})))

(executable
 (name machdepArchConfigure)
 (modules machdepArchConfigure)
 (libraries dune-configurator))

(rule
 (deps machdep32-config.h machdep-ml.c)
 (target machdep32)
 (action (with-stdout-to %{target} (run ./machdepArchConfigure.exe --cc %{read-lines:../bin/real-gcc} -m 32))))

(rule
 (deps machdep64-config.h machdep-ml.c)
 (target machdep64)
 (action (with-stdout-to %{target} (run ./machdepArchConfigure.exe --cc %{read-lines:../bin/real-gcc} -m 64))))

; for Cilly.pm
(executable
 (name modelConfigure)
 (modules modelConfigure)
 (libraries yojson dune-configurator modelCommon)
)

; for Cilly.pm
(rule
 (target gcc32model)
 (action (with-stdout-to %{target} (run ./modelConfigure.exe --cc %{read-lines:../bin/real-gcc} -m 32))))

; for Cilly.pm
(rule
 (target gcc64model)
 (action (with-stdout-to %{target} (run ./modelConfigure.exe --cc %{read-lines:../bin/real-gcc} -m 64))))

(rule
 (deps machdep32 machdep64)
 (target machdep.ml)
 (action (run %{bin:cppo} -V OCAML:%{ocaml_version}
              %{dep:machdep.cppo.ml} -x machdep:./%{dep:machdep-ml.exe}
              -o %{target})))

(ocamllex formatlex)
(ocamlyacc formatparse)

(executable
 (name main)
 (modules main mainFeature ciloptions)
 (modes native)
 (libraries goblint-cil dynlink findlib yojson ppx_deriving_yojson.runtime modelCommon)
 (flags :standard -linkall))

(env
  (dev
    (flags (:standard -warn-error -A -w -unused-var-strict)) ; https://dune.readthedocs.io/en/stable/faq.html#how-to-make-warnings-non-fatal
  )
)
